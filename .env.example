# LIVE ARENA — variáveis de ambiente (copie para .env e preencha).
# NUNCA versione o .env. Gere segredos com: openssl rand -base64 48

NODE_ENV="production"
APP_NAME="LIVE ARENA"

# ---------- Banco e Redis ----------
# Desenvolvimento local (sem Docker):
DATABASE_URL="postgresql://postgres:SUA_SENHA@127.0.0.1:5432/livearena?schema=public&connection_limit=10"
REDIS_URL="redis://127.0.0.1:6379"
# Docker Compose (usados para montar as URLs internas):
POSTGRES_USER="livearena"
POSTGRES_PASSWORD=""
POSTGRES_DB="livearena"
REDIS_PASSWORD=""

# ---------- Segredos (obrigatórios; mínimo 32 caracteres) ----------
JWT_ACCESS_SECRET=""
JWT_REALTIME_SECRET=""
# Chaves AES-256-GCM em base64 (32 bytes). A primeira cifra; todas decifram (rotação).
#   ENCRYPTION_KEYS="k2:$(openssl rand -base64 32),k1:<chave antiga>"
ENCRYPTION_KEYS=""
SECRET_PEPPER=""
# Protege /metrics (opcional na rede interna)
METRICS_TOKEN=""

# ---------- URLs ----------
PUBLIC_WEB_URL="https://seu-dominio.com"
PUBLIC_REALTIME_URL="https://seu-dominio.com"
NEXT_PUBLIC_REALTIME_URL="https://seu-dominio.com"
CORS_ORIGINS="https://seu-dominio.com"
API_INTERNAL_URL="http://api:4000"
INTERNAL_WEB_URL="http://web:3000"
DOMAIN="seu-dominio.com"
# true somente atrás de um proxy de borda que SOBRESCREVE X-Forwarded-For (Caddy/nginx fornecidos)
EDGE_PROXY="true"

# ---------- Políticas ----------
SIGNUP_ENABLED="true"
ADMIN_MFA_REQUIRED="true"
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL_DAYS="30"
FAULT_INJECTION_ENABLED="false"

# ---------- E-mail (recuperação de senha) ----------
SMTP_URL=""
MAIL_FROM="LIVE ARENA <no-reply@seu-dominio.com>"

# ---------- Capacidade ----------
RUNNER_MAX_SESSIONS="20"
GAME_RUNNER_REPLICAS="2"
INGEST_CONCURRENCY="32"
INGEST_BACKPRESSURE_LIMIT="20000"
STREAM_MAX_PIPELINES="2"

# ---------- Fontes de eventos do TikTok ----------
# Serviço gerenciado (contrato + API key). Confirme a URL na documentação oficial do provedor.
EULER_WS_URL=""
EULER_API_KEY=""
# Biblioteca tiktok-live-connector (AGPL-3.0 c/ exceções). LEIA docs/LICENSE_AUDIT.md antes.
TTLC_ENABLED="false"
TTLC_LICENSE_ACK=""

# ---------- Observabilidade ----------
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT=""
GRAFANA_ADMIN_PASSWORD=""
