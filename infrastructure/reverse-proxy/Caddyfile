# Proxy de borda (TLS automático com DOMAIN real; HTTP local com DOMAIN=localhost).
# IMPORTANTE: sobrescreve X-Forwarded-For com o IP real do cliente, impedindo
# falsificação de IP (rate limit). O web roda com EDGE_PROXY=true por causa disso.
{
	admin off
	auto_https disable_redirects
}

:8080, {$DOMAIN}:8443 {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	# WebSocket / Socket.IO
	handle /socket.io/* {
		reverse_proxy realtime:4001 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Métricas e saúde internas não são publicadas.
	@internal path /api/metrics* /metrics*
	respond @internal 404

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
